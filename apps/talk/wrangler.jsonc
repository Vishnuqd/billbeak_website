{
  // Cloudflare Workers static-assets config for the /talk app.
  // Serves the Vite build (dist/) as a single-page application. No server code —
  // this is an assets-only Worker (there is no "main" entry).
  "name": "billbeak-website",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
