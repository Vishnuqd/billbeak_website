{
  "purpose": "Email/notification configuration for the Join Billbeak journey.",
  "journeyKey": "join",
  "messages": [
    {
      "id": "internal_notification",
      "type": "internal",
      "recipientRule": "team:people_ops",
      "subject": "New inbound interest — {firstName} ({interestArea})",
      "variables": ["firstName", "interestArea", "currentRole", "whyBillbeak", "linkedin", "cv", "portfolio", "leadScore"],
      "delayMinutes": 0
    },
    {
      "id": "visitor_confirmation",
      "type": "visitor",
      "recipientRule": "visitor:email",
      "subject": "Thanks for raising your hand, {firstName}",
      "variables": ["firstName"],
      "delayMinutes": 0
    },
    {
      "id": "review_followup",
      "type": "visitor",
      "recipientRule": "visitor:email",
      "subject": "An update on your interest in Billbeak",
      "variables": ["firstName"],
      "delayMinutes": 10080,
      "condition": "no_status_change"
    }
  ]
}
