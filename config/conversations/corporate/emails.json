{
  "purpose": "Email/notification configuration for the Corporate Training journey.",
  "journeyKey": "corporate",
  "messages": [
    {
      "id": "internal_notification",
      "type": "internal",
      "recipientRule": "team:corporate_programmes",
      "subject": "New corporate programme enquiry — {organisationName} ({journeyStage})",
      "variables": ["firstName", "organisationName", "orgSize", "capabilityAreas", "capabilityDetail", "journeyStage", "decisionMaker", "location", "programmeBrief", "leadScore"],
      "delayMinutes": 0
    },
    {
      "id": "visitor_confirmation",
      "type": "visitor",
      "recipientRule": "visitor:email",
      "subject": "We've received your programme enquiry, {firstName}",
      "variables": ["firstName", "organisationName"],
      "delayMinutes": 0
    },
    {
      "id": "followup",
      "type": "visitor",
      "recipientRule": "visitor:email",
      "subject": "Shaping the right programme for {organisationName}",
      "variables": ["firstName", "organisationName"],
      "delayMinutes": 1440,
      "condition": "no_reply"
    },
    {
      "id": "owner_reminder",
      "type": "internal",
      "recipientRule": "owner",
      "subject": "Reminder: corporate enquiry from {organisationName} awaiting first response",
      "variables": ["organisationName", "leadScore", "journeyStage"],
      "delayMinutes": 2880,
      "condition": "unactioned"
    }
  ]
}
