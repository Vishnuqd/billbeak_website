    { "type": "talent_engineering_review", "label": "Talent Engineering Review", "trigger": "crm:stage=review", "emitNow": false, "visibility": "private" },
    { "type": "passport_started", "label": "Passport Started", "trigger": "passport:created", "emitNow": false, "visibility": "private", "verification": "pending" },
    { "type": "represented", "label": "Represented", "trigger": "crm:stage=represented", "emitNow": false, "visibility": "private", "verification": "verified" },
    { "type": "interview", "label": "Interview", "trigger": "crm:stage=interview", "emitNow": false, "visibility": "private" },
    { "type": "opportunity_closed", "label": "Opportunity Closed", "trigger": "crm:stage=closed", "emitNow": false, "visibility": "private" }
  ]
}
