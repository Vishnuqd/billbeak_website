# Copy to .env and adjust. All values have safe defaults for local dev.

# Async SQLAlchemy URL. Postgres for production; SQLite for quick local runs/tests.
DATABASE_URL=postgresql+asyncpg://billbeak:billbeak@localhost:5432/billbeak
# DATABASE_URL=sqlite+aiosqlite:///./billbeak.sqlite3

# Require TLS to the database. Set true for managed Postgres (e.g. Neon); leave
# false for local Postgres/SQLite.
DB_SSL=false

# Absolute or relative path to the frozen business configuration.
# Defaults to <repo>/config/conversations when unset.
# CONFIG_DIR=../../config/conversations

ENVIRONMENT=development

# Uploads: local | s3 | r2
UPLOAD_PROVIDER=local
UPLOAD_DIR=./uploads
# UPLOAD_BUCKET=billbeak-uploads
# UPLOAD_S3_ENDPOINT=            # set for Cloudflare R2
# UPLOAD_S3_REGION=eu-north-1

# Email + CRM providers (queue/adapter only; no external calls yet)
EMAIL_PROVIDER=log
CRM_PROVIDER=none

# Comma-separated CORS origins for the /talk app
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
